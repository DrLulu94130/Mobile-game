rules_version = '2';

// Firestore security rules for Inkognito.
//
// Principles:
//  * Anyone signed in can read public content and profiles.
//  * Users may only write their own profile and their own authored content.
//  * Progression fields (xp, level, counters) may only move by plausible
//    per-action amounts, and social counters by a single step per write, so
//    a tampered client cannot fabricate leaderboard positions in one shot.
//    Cloud Functions (Admin SDK) bypass these rules for server-side awards.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Numeric field of a document map, treating missing or null as 0.
    function num0(data, field) {
      return data.get(field, 0) == null ? 0 : data.get(field, 0);
    }

    function newN(field) {
      return num0(request.resource.data, field);
    }

    function oldN(field) {
      return num0(resource.data, field);
    }

    // The write moves `field` by a delta within [minDelta, maxDelta].
    function deltaWithin(field, minDelta, maxDelta) {
      return newN(field) - oldN(field) >= minDelta
          && newN(field) - oldN(field) <= maxDelta;
    }

    // --- Users / profiles ---
    match /users/{uid} {
      allow read: if isSignedIn();

      // New profiles must start with zero progression.
      allow create: if isOwner(uid)
          && newN('xp') == 0
          && newN('level') <= 1
          && newN('challengesCreated') == 0
          && newN('challengesSolved') == 0
          && newN('perfectSolves') == 0
          && newN('totalLikes') == 0
          && newN('streakDays') <= 1;

      // Owners update their own profile, but progression can only advance
      // by what a single action can legitimately award: one solve/creation,
      // a bounded XP payout, one streak day (or a reset to 1 when broken).
      allow update: if isOwner(uid)
          && deltaWithin('xp', 0, 500)
          && deltaWithin('level', 0, 5)
          && deltaWithin('challengesCreated', 0, 1)
          && deltaWithin('challengesSolved', 0, 1)
          && deltaWithin('perfectSolves', 0, 1)
          && deltaWithin('totalLikes', 0, 1)
          && (newN('streakDays') == 1 || deltaWithin('streakDays', 0, 1))
          && request.resource.data.get('badgeIds', []) is list
          && request.resource.data.get('badgeIds', []).size() <= 100;

      allow delete: if false;
    }

    // --- Challenges ---
    match /challenges/{challengeId} {

      // Social interactions from any signed-in player: like/unlike, one
      // play, one comment per write, and a best time that can only improve.
      function isSocialBump() {
        return request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['likeCount', 'playCount', 'commentCount',
                             'bestTimeMs'])
            && deltaWithin('likeCount', -1, 1)
            && deltaWithin('playCount', 0, 1)
            && deltaWithin('commentCount', 0, 1)
            && (newN('bestTimeMs') == oldN('bestTimeMs')
                || (newN('bestTimeMs') > 0
                    && (oldN('bestTimeMs') == 0
                        || newN('bestTimeMs') < oldN('bestTimeMs'))));
      }

      allow read: if isSignedIn() &&
                     (resource.data.isPublic == true ||
                      isOwner(resource.data.authorId));

      // New challenges start with pristine social counters.
      allow create: if isSignedIn()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 60
          && request.resource.data.inklings.size() <= 12
          && newN('likeCount') == 0
          && newN('playCount') == 0
          && newN('commentCount') == 0
          && newN('bestTimeMs') == 0;

      // Authors edit their own challenge but never its social counters;
      // everyone else is limited to single-step counter bumps.
      allow update: if (isOwner(resource.data.authorId)
              && !request.resource.data.diff(resource.data).affectedKeys()
                     .hasAny(['likeCount', 'playCount', 'commentCount',
                              'bestTimeMs'])) ||
          (isSignedIn() && isSocialBump());

      allow delete: if isOwner(resource.data.authorId);

      // Likes: one document per user.
      match /likes/{uid} {
        allow read: if isSignedIn();
        allow write: if isOwner(uid);
      }

      // Comments: author-owned, immutable text.
      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() &&
                         request.resource.data.authorId == request.auth.uid &&
                         request.resource.data.text is string &&
                         request.resource.data.text.size() <= 300;
        allow update: if false;
        allow delete: if isOwner(resource.data.authorId);
      }
    }

    // --- Attempts (play results) ---
    match /attempts/{attemptId} {
      allow read: if isSignedIn();

      // Results must be internally consistent and within the bounds the
      // scoring formula can actually produce (max 2000).
      allow create: if isSignedIn()
          && request.resource.data.playerId == request.auth.uid
          && newN('totalInklings') >= 1
          && newN('totalInklings') <= 12
          && newN('foundCount') >= 0
          && newN('foundCount') <= newN('totalInklings')
          && newN('durationMs') >= 0
          && newN('score') >= 0
          && newN('score') <= 2000
          && request.resource.data.get('taps', []) is list
          && request.resource.data.get('taps', []).size() <= 1000;

      allow update, delete: if false;
    }
  }
}
